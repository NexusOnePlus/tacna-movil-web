# ============================================================
# Supabase - claves públicas (seguras para el cliente)
# ============================================================
VITE_SUPABASE_URL=https://XXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.XXXXX

# ============================================================
# MapLibre - estilo del mapa (OpenFreeMap, gratis, sin API key)
# ============================================================
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# ============================================================
# Entorno
# ============================================================
VITE_APP_ENV=development

# ============================================================
# Dominio base para separar landing (tacna-movil) y panel (tacna-panel).
# Es opcional: si no se define, se deduce del host de la request
# (tacna-panel.dominio.com -> dominio.com). Definelo solo si quieres
# forzarlo, por ejemplo con un dominio que no siga esa convención.
# ============================================================
# VITE_PANEL_BASE_DOMAIN=glook.pro
